# Frontend environment variables — only VITE_* vars are needed here.
# All other project variables are managed from the project root .env.
# See /.env.example for the full variable reference.

# Browser-facing API base URL (used by the React app at runtime)
VITE_API_URL=http://localhost:8000

# Optional: overrides Vite dev-server proxy target without changing the browser API URL.
# VITE_PROXY_TARGET=http://backend:8000
