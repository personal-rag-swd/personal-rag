# ── Database ──────────────────────────────────────────────────────────────────
# Used by: backend (local dev via `uv run fastapi dev`)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/personal_rag

# ── PostgreSQL container (docker-compose) ─────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=personal_rag

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-32-byte-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── CORS & Cookies ────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
S3_BUCKET=personal-rag-bucket
S3_REGION=us-east-1
# Used by the backend when running directly on the host.
S3_ENDPOINT_URL=http://localhost:9000
# Browser-facing URL for generated presigned URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── MinIO container (docker-compose) ─────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Browser-facing API base URL (used by the React app at runtime)
VITE_API_URL=http://localhost:8000
# Optional Vite dev-server proxy target override.
VITE_PROXY_TARGET=http://backend:8000
