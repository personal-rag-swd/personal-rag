# ── Database (MongoDB) ────────────────────────────────────────────────────────
# Use mongodb://localhost:27017/personal-rag for local dev MongoDB container
# Or MongoDB Atlas connection string: mongodb+srv://user:password@cluster.mongodb.net/personal-rag
DATABASE_URL=mongodb://localhost:27017/personal-rag

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-32-byte-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=INFO

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# ── LLM & Embeddings (Unified / Centralized) ──────────────────────────────────
# Only "openrouter" is supported. Set CHAT_API_KEY to your OpenRouter API key.
CHAT_PROVIDER=openrouter
CHAT_API_KEY=
CHAT_PROVIDER_URL=
CHAT_MODEL=openai/gpt-4o-mini

# Embeddings also go through OpenRouter using CHAT_API_KEY (no separate key needed).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── File ingestion recovery / RabbitMQ consumer ──────────────────────────────
FILE_INGESTION_PROCESSING_TIMEOUT_MINUTES=15
RABBITMQ_CONSUMER_ENABLED=true
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_NAME=minio-events
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_ROUTING_KEY=minio.object.created
RABBITMQ_QUEUE_NAME=notebook-document-ingestion
RABBITMQ_DEAD_LETTER_EXCHANGE_NAME=minio-events-dlx
RABBITMQ_DEAD_LETTER_QUEUE_NAME=notebook-document-ingestion-dead-letter
RABBITMQ_DEAD_LETTER_ROUTING_KEY=notebook-document-ingestion.dead-letter
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_RECONNECT_DELAY_SECONDS=5

# ── CORS & Cookies ────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
S3_BUCKET=personal-rag-bucket
S3_REGION=us-east-1
# Endpoint used by backend to connect to MinIO
S3_ENDPOINT_URL=http://localhost:9000
# Browser-facing public endpoint for presigned URLs
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# MinIO root credentials (used by docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BROWSER_REDIRECT_URL=
MINIO_SERVER_URL=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_PROXY_TARGET=http://backend:8000

# ── Logging / Tracing (Logfire) ───────────────────────────────────────────────
LOGFIRE_TOKEN=

# ── Billing (Polar.sh) ────────────────────────────────────────────────────────
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=sandbox
POLAR_ORGANIZATION_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_MAX_PRODUCT_ID=
POLAR_LLM_TOKENS_METER_ID=
POLAR_SUCCESS_URL=http://localhost:5173/settings/billing?checkout=success
POLAR_USAGE_EMIT_INTERVAL_SECONDS=60
POLAR_USAGE_EMIT_BATCH_SIZE=100
POLAR_USAGE_EMIT_MAX_RETRIES=5
FREE_TIER_LLM_TOKENS_ALLOWANCE=6000000
PRO_TIER_LLM_TOKENS_ALLOWANCE=20000000
MAX_TIER_LLM_TOKENS_ALLOWANCE=140000000
