# ── Database ──────────────────────────────────────────────────────────────────
# Used by: backend (local dev via `uv run fastapi dev`)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/personal_rag

# ── PostgreSQL container (docker-compose) ─────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=personal_rag

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-32-byte-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=DEBUG

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# ── LLM (Unified / Centralized) ────────────────────────────────────────────────
# Chat Settings
CHAT_PROVIDER=openrouter
CHAT_API_KEY=
CHAT_PROVIDER_URL=
CHAT_MODEL=openai/gpt-4o-mini

# Embedding Settings
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DELAY_SECONDS=0.5
EMBEDDING_MAX_RETRIES=5

# ── File ingestion recovery / RabbitMQ consumer ──────────────────────────────
FILE_INGESTION_PROCESSING_TIMEOUT_MINUTES=15
RABBITMQ_CONSUMER_ENABLED=true
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_NAME=minio-events
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_ROUTING_KEY=minio.object.created
RABBITMQ_QUEUE_NAME=notebook-document-ingestion
RABBITMQ_DEAD_LETTER_EXCHANGE_NAME=minio-events-dlx
RABBITMQ_DEAD_LETTER_QUEUE_NAME=notebook-document-ingestion-dead-letter
RABBITMQ_DEAD_LETTER_ROUTING_KEY=notebook-document-ingestion.dead-letter
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_RECONNECT_DELAY_SECONDS=5

# ── CORS & Cookies ────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
S3_BUCKET=personal-rag-bucket
S3_REGION=us-east-1
# Used by the backend when running directly on the host.
S3_ENDPOINT_URL=http://localhost:9000
# Browser-facing URL for generated presigned URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── MinIO container (docker-compose) ─────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── MinIO public URLs (production) ───────────────────────────────────────────
MINIO_BROWSER_REDIRECT_URL=
MINIO_SERVER_URL=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Browser-facing API base URL (used by the React app at runtime)
VITE_API_URL=http://localhost:8000


# ── Logging / Tracing (Logfire) ───────────────────────────────────────────────
LOGFIRE_TOKEN=
